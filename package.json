{
  "name": "remotion-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"tsx watch server/index.ts\"",
    "web": "vite",
    "server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@babel/standalone": "^8.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@remotion/bundler": "^4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "express": "^5.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.545"
  },
  "devDependencies": {
    "@types/babel__standalone": "^7.1.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
